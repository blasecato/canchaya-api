DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/canchaya?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Compatibilidad temporal con archivos públicos históricos. Las cargas nuevas
# se almacenan en Cloudinary.
UPLOADS_DIRECTORY="./uploads"
# Compatibilidad temporal con documentos de identidad históricos.
PRIVATE_UPLOADS_DIRECTORY="./private-uploads"
# Genera un valor privado, por ejemplo: openssl rand -hex 32
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN_SECONDS=86400
JWT_REMEMBER_ME_EXPIRES_IN_SECONDS=2592000
JWT_ISSUER="canchaya-api"
JWT_AUDIENCE="canchaya-web"
# Credenciales privadas del backend. Nunca uses estas variables en Vite.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
