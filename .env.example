DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/canchaya?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Recordatorios internos de partidos. El cron predeterminado se ejecuta cada
# cinco minutos y la clave idempotente evita avisos duplicados.
MATCH_REMINDERS_ENABLED=true

# Compatibilidad temporal con archivos públicos históricos. Las cargas nuevas
# se almacenan en Cloudinary.
UPLOADS_DIRECTORY="./uploads"
# Compatibilidad temporal con documentos de identidad históricos.
PRIVATE_UPLOADS_DIRECTORY="./private-uploads"
# Genera un valor privado, por ejemplo: openssl rand -hex 32
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN_SECONDS=86400
JWT_REMEMBER_ME_EXPIRES_IN_SECONDS=2592000
JWT_ISSUER="canchaya-api"
JWT_AUDIENCE="canchaya-web"
# Credenciales privadas del backend. Nunca uses estas variables en Vite.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Envío de correos (recuperación de contraseña). Sin estas variables el código
# se escribe en la consola en lugar de enviarse.
MAIL_HOST=
MAIL_PORT=587
# true solo cuando el puerto es 465
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="ASPROFUTPI <no-reply@asprofutpitorneos.com>"
MAIL_SUPPORT_ADDRESS="soporte@asprofutpitorneos.com"
# Teléfono que aparece en el pie del correo. Vacío = no se muestra.
MAIL_CONTACT_PHONE="+57 320 000 0000"
# URL pública del escudo. Vacía = se incrusta el archivo local como adjunto.
MAIL_LOGO_URL=
APP_PUBLIC_URL="https://asprofutpitorneos.com"
APP_NAME="ASPROFUTPI"
