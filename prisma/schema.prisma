/// Stores revocable JWT sessions. The raw JWT identifier is never persisted;
/// only its SHA-256 hash is stored.
/// This table contains check constraints defined in prisma/sql/add_auth_sessions.sql.
model auth_sessions {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  jti_hash   String    @unique(map: "auth_sessions_jti_hash_uk") @db.Char(64)
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "auth_sessions_user_fkey")

  @@index([expires_at], map: "auth_sessions_expires_at_idx")
  @@index([user_id, revoked_at], map: "auth_sessions_user_revoked_idx")
}

