  player_match_stats                                                                              player_match_stats[]
  referee_assignment_events                                                                       referee_assignment_events[]

  @@unique([id, tournament_id], map: "matches_id_tournament_uk")
  @@unique([tournament_id, competition_key], map: "matches_competition_key_uk")
  @@index([away_team_id], map: "matches_away_team_idx")
  @@index([home_team_id], map: "matches_home_team_idx")
  @@index([tournament_id, match_date], map: "matches_tournament_date_idx")
